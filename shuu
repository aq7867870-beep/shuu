<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday Shruti ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#080609;
    color:#fff;
    font-family:Poppins,sans-serif;
    overflow-x:hidden;
}

/* Floating hearts */
.heart{
    position:fixed;
    bottom:-30px;
    color:#ff6f9f;
    animation:float 7s linear forwards;
    pointer-events:none;
    z-index:10;
}

@keyframes float{
    0%{
        transform:translateY(0) rotate(0);
        opacity:0;
    }
    20%{opacity:.8;}
    100%{
        transform:translateY(-110vh) rotate(30deg);
        opacity:0;
    }
}

/* HERO */

.hero{
    position:relative;
    isolation:isolate;
    overflow:hidden;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:30px 20px;

    background:
    radial-gradient(1px 1px at 12% 22%,#ffe1ea99 50%,transparent 100%),
    radial-gradient(1px 1px at 82% 18%,#ffe1ea88 50%,transparent 100%),
    radial-gradient(1px 1px at 72% 68%,#ffe1ea77 50%,transparent 100%),
    radial-gradient(1px 1px at 24% 76%,#ffe1ea88 50%,transparent 100%),
    radial-gradient(ellipse at 50% 24%,#64243f 0%,#24101c 42%,#080609 78%);
}

.hero > *{
    opacity:0;
    animation:arrive .8s ease-out forwards;
}

.hero .small{animation-delay:.1s;}
.hero h1{animation-delay:.25s;}
.hero .subtitle{animation-delay:.4s;}
.hero .countdown{animation-delay:.55s;}
.hero .music{animation-delay:.7s;}
.hero .scroll{animation-delay:.85s;}

@keyframes arrive{
    from{opacity:0;transform:translateY(14px);}
    to{opacity:1;transform:translateY(0);}
}

.small{
    color:#ff9fbe;
    font-size:11px;
    letter-spacing:4px;
    text-transform:uppercase;
}

h1{
    font-family:"Cormorant Garamond",serif;
    font-size:clamp(52px,12vw,130px);
    line-height:.9;
    margin:25px 0;
}

h1 span{
    color:#ff6f9f;
    text-shadow:0 0 35px #ff4d8a;
}

.subtitle{
    color:#b9aab1;
    font-size:14px;
}

.countdown{
    display:flex;
    gap:10px;
    margin:40px 0 25px;
}

.time{
    width:75px;
    padding:15px 5px;
    border:1px solid #ffffff18;
    border-radius:18px;
    background:#ffffff08;
    backdrop-filter:blur(10px);
}

.time b{
    display:block;
    font-size:25px;
}

.time small{
    color:#9e8d95;
    font-size:9px;
    text-transform:uppercase;
}

.music{
    padding:13px 25px;
    border-radius:30px;
    border:1px solid #ff719f77;
    background:#ff719f15;
    color:#ffd9e5;
    cursor:pointer;
    font-family:Poppins;
    transition:background .25s ease,transform .25s ease,border-color .25s ease;
}

.music:hover{
    background:#ff719f30;
    border-color:#ff9fbe;
    transform:translateY(-2px);
}

.scroll{
    margin-top:60px;
    color:#766870;
    font-size:10px;
    letter-spacing:2px;
}

/* LETTER */

section{
    padding:100px 20px;
}

.story-page{
    display:none;
    min-height:100svh;
    padding-bottom:110px;
}

.story-page.is-active{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    animation:scene-in .45s ease-out both;
}

.story-page[hidden],
.choice-reveal[hidden]{
    display:none !important;
}

@keyframes scene-in{
    from{opacity:0;transform:translateY(10px);}
    to{opacity:1;transform:translateY(0);}
}

.tease-page{
    gap:18px;
    text-align:center;
    background:radial-gradient(ellipse at 50% 35%,#351827 0%,#100b10 68%);
}

.tease-page h2{
    max-width:720px;
    margin:4px 0;
    font-size:clamp(42px,8vw,68px);
}

.tease-copy{
    max-width:500px;
    color:#d3c7cc;
    font-size:15px;
    line-height:1.8;
}

.choice-list{
    display:grid;
    width:min(100%,440px);
    gap:12px;
    margin-top:12px;
}

.choice-option{
    min-height:54px;
    padding:13px 18px;
    border:1px solid #ff9fbe66;
    border-radius:12px;
    background:#ff719f12;
    color:#ffe1ea;
    font:500 14px Poppins,sans-serif;
    cursor:pointer;
    transition:background .2s ease,border-color .2s ease,transform .2s ease;
}

.choice-option:hover{
    transform:translateY(-2px);
    border-color:#ff9fbe;
    background:#ff719f28;
}

.choice-reveal{
    max-width:560px;
    margin:0 auto 22px;
    color:#ffc9da;
    font-family:"Cormorant Garamond",serif;
    font-size:25px;
    line-height:1.5;
    text-align:center;
}

.page-controls{
    position:fixed;
    z-index:20;
    right:0;
    bottom:0;
    left:0;
    display:grid;
    grid-template-columns:48px 1fr 48px;
    align-items:center;
    gap:16px;
    padding:14px max(20px,calc((100vw - 680px)/2));
    border-top:1px solid #ff9fbe20;
    background:linear-gradient(180deg,#100b10e8,#100b10f7);
    backdrop-filter:blur(14px);
}

.page-arrow{
    display:grid;
    width:46px;
    height:46px;
    place-items:center;
    border:1px solid #ff9fbe66;
    border-radius:50%;
    background:#ff719f18;
    color:#ffe1ea;
    font-size:21px;
    cursor:pointer;
    transition:background .2s ease,transform .2s ease;
}

.page-arrow:hover:not(:disabled){
    transform:translateY(-2px);
    background:#ff719f35;
}

.page-arrow:disabled{
    opacity:.35;
    cursor:not-allowed;
}

.page-arrow[hidden]{
    display:none;
}

.page-status{
    display:grid;
    justify-items:center;
    gap:7px;
    color:#c5b5bc;
    font-size:10px;
    letter-spacing:2px;
}

.progress-track{
    width:min(100%,220px);
    height:2px;
    overflow:hidden;
    background:#ffffff20;
}

.progress-fill{
    display:block;
    width:0;
    height:100%;
    background:#ff9fbe;
    transition:width .35s ease;
}

.card{
    position:relative;
    overflow:hidden;
    max-width:700px;
    margin:auto;
    padding:55px;
    border-radius:20px;
    background:linear-gradient(145deg,#1a1218,#0e0a0e);
    border:1px solid #ff9fbe30;
    box-shadow:0 25px 80px #000,0 0 45px #ff6f9f0c;
}

.card::before{
    content:"";
    position:absolute;
    top:0;
    left:12%;
    width:76%;
    height:1px;
    background:linear-gradient(90deg,transparent,#ffd4e2,transparent);
}

.label{
    color:#ff9fbe;
    letter-spacing:4px;
    font-size:10px;
    text-transform:uppercase;
}

h2{
    font-family:"Cormorant Garamond",serif;
    font-size:55px;
    margin:15px 0 25px;
}

.card p{
    color:#d3c7cc;
    font-size:14px;
    line-height:2;
    margin:18px 0;
}

.signature{
    font-family:"Cormorant Garamond",serif;
    font-size:27px !important;
    color:#ffc9da !important;
    margin-top:35px !important;
}

/* FINAL */

.final{
    min-height:80vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}

.final h2{
    font-size:60px;
}

.final p{
    color:#c5b5bc;
    line-height:2;
    font-size:13px;
}

.bigheart{
    font-size:90px;
    color:#ff6f9f;
    text-shadow:0 0 50px #ff4d8a;
    animation:pulse 1.5s infinite;
    margin:25px;
}

@keyframes pulse{
    50%{
        transform:scale(1.15);
    }
}

.last{
    font-family:"Cormorant Garamond",serif;
    font-size:25px !important;
    color:#ffc9da !important;
}

@media(max-width:600px){

    .countdown{
        gap:6px;
    }

    .time{
        width:68px;
    }

    .card{
        padding:30px 25px;
    }

    .final h2{
        font-size:45px;
    }
}

@media(prefers-reduced-motion:reduce){
    *,*::before,*::after{
        scroll-behavior:auto !important;
        animation-duration:.01ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.01ms !important;
    }

    .hero > *{
        opacity:1;
    }
}
</style>
</head>

<body>

<!-- ================= HERO ================= -->

<div class="story-page hero is-active">

<p class="small">for my favourite girl ♡</p>

<h1>
Happy Birthday<br>
<span>Shruti</span> ✨
</h1>

<p class="subtitle">
for my Shuu, my favourite person, my forever smile.
</p>

<div class="countdown">

<div class="time">
<b id="days">00</b>
<small>Days</small>
</div>

<div class="time">
<b id="hours">00</b>
<small>Hours</small>
</div>

<div class="time">
<b id="minutes">00</b>
<small>Minutes</small>
</div>

<div class="time">
<b id="seconds">00</b>
<small>Seconds</small>
</div>

</div>

<button class="music" onclick="playMusic()">
♡ Play our song
</button>

<audio id="song" loop>
<source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3" type="audio/mpeg">
</audio>

<p class="scroll">
one little surprise at a time ♡
</p>

</div>

<section class="story-page tease-page choice-page">

<p class="label">before the surprise...</p>

<h2>Important birthday question 👀</h2>

<p class="tease-copy">
Who is the cutest person celebrating today? Choose carefully, Shuu. 😌
</p>

<div class="choice-list">
<button class="choice-option" data-reveal-target="first-choice-reveal" data-reveal="That confidence is adorable. Don't let it go to your head, birthday girl. 😏💗" onclick="chooseOption(this)">
Me. Obviously. 👑
</button>
<button class="choice-option" data-reveal-target="first-choice-reveal" data-reveal="Correct answer. I knew you would figure out that it's you, Shuu. 😉💕" onclick="chooseOption(this)">
The birthday girl, of course 😇
</button>
</div>

</section>

<section class="story-page tease-page choice-page">

<p class="choice-reveal" id="first-choice-reveal" role="status" hidden></p>

<p class="label">one last test...</p>

<h2>Ready for your surprise? 🎁</h2>

<p class="tease-copy">
Be honest. Are you going to pretend you had no idea I made something for you? 🙃
</p>

<div class="choice-list">
<button class="choice-option" data-reveal-target="second-choice-reveal" data-reveal="I knew you'd say that. You're very easy to spoil, Shuu. 🎀💞" onclick="chooseOption(this)">
Nope. I deserve to be spoiled 😌
</button>
<button class="choice-option" data-reveal-target="second-choice-reveal" data-reveal="A snack and a surprise? You drive a hard bargain, birthday girl. 🍰✨" onclick="chooseOption(this)">
Only if there's cake involved 🍰
</button>
</div>

</section>


<!-- ================= LETTER ================= -->

<section class="story-page letter-page">

<p class="choice-reveal" id="second-choice-reveal" role="status" hidden></p>

<div class="card">

<p class="label">
a little birthday letter
</p>

<h2>
Dear Shuu,
</h2>

<p>
Happy birthday, my Shruti, my Shuu, my most precious girl. ♡
I still don't know how you managed to become this important to me,
but somehow you did. And now, every part of you feels like a little home to me. 🏡💗
</p>

<p>
I love the way you get angry, the way you pout, the way you act annoyed,
and the way I still end up smiling because of you. I love irritating you,
I love teasing you, and I love how your little reactions make my heart feel so full.
Even your tiny mood swings and your "Guu" obsession somehow become adorable to me. 😅💕
And I haven't forgotten that cute little video you promised me. I'm still waiting, birthday girl. 😏📹💕
</p>

<p>
Honestly, you're the best person in my life, and I feel so lucky to have you in it. 🌷
Sometimes you get angry and I don't even know why, but somehow it still makes me smile
because it's just another little part of the person I love so much. And whatever happens,
even after a difficult moment, we find our way back to each other. That means more to me
than I can explain. I love you for all of you, Shuu. 🫶✨
</p>

<p>
I care about you in a way that feels deeper than words can explain.
I care about your happiness, your peace, your heart, your silence,
and even the moments when you say you're okay but I can see you're not.
I care about the real you, the shy you, the tired you, the angry you,
and the softest version of you that I never want to lose. 🥺🤍
</p>

<p>
You are not just someone I like or someone I talk to every day.
You are the person who has found a place in my heart without even trying.
You are my Shuu, my comfort, my favorite chaos, and the girl I would choose again and again. 💞
</p>

<p>
I hope this new year of your life brings you all the love, peace, laughter,
and beautiful memories you deserve. More happiness. More calm. More reasons to smile.
And maybe, just maybe, a little more of my luvv in your life too. ♡
</p>

<p>
So today, my babbay, please let your heart be light for a while.
Forget the tiredness, the worries, and everything else.
Today is about you, because you deserve to feel celebrated,
cherished, and deeply loved the way you always have been to me.
</p>

<p class="signature">
Happy Birthday, my Shruti. 🖤<br>
— your luvv
</p>

</div>

</section>


<!-- ================= FINAL ================= -->

<section class="story-page final">

<p class="label">
one last thing, shuu...
</p>

<h2>
You matter to me. ♡
</h2>

<p>
No matter how many birthdays come after this one,<br>
I hope you always remember how deeply you are loved, how precious you are,
and how much your smile means to me.
</p>

<div class="bigheart">
♥
</div>

<p class="last">
Happy Birthday, my Shuu, my Shruti. ♡<br>
Your luvv will always be cheering for you,
protecting your peace, and loving you more than words can say.
</p>

</section>

<nav class="page-controls" aria-label="Birthday surprise navigation">
<button class="page-arrow" id="previous-page" type="button" onclick="changePage(-1)" aria-label="Previous page" title="Previous page">←</button>
<div class="page-status" aria-live="polite">
<span id="page-count">01 / 01</span>
<span class="progress-track" role="progressbar" aria-label="Surprise progress" aria-valuemin="1" aria-valuemax="1" aria-valuenow="1"><span class="progress-fill" id="progress-fill"></span></span>
</div>
<button class="page-arrow" id="next-page" type="button" onclick="changePage(1)" aria-label="Next page" title="Next page">→</button>
</nav>


<script>

const storyPages = Array.from(document.querySelectorAll(".story-page"));
let currentPage = 0;

function showPage(pageIndex){
    if(pageIndex < 0 || pageIndex >= storyPages.length){
        return;
    }

    currentPage = pageIndex;

    storyPages.forEach((page, index) => {
        const isActive = index === currentPage;
        page.hidden = !isActive;
        page.classList.toggle("is-active", isActive);
        page.setAttribute("aria-hidden", String(!isActive));
    });

    const previousButton = document.getElementById("previous-page");
    const nextButton = document.getElementById("next-page");
    const pageCount = document.getElementById("page-count");
    const progressBar = document.querySelector(".progress-track");
    const progressFill = document.getElementById("progress-fill");
    const isLastPage = currentPage === storyPages.length - 1;
    const mustChoose = storyPages[currentPage].classList.contains("choice-page");

    previousButton.disabled = currentPage === 0;
    nextButton.disabled = mustChoose;
    nextButton.textContent = isLastPage ? "↺" : "→";
    nextButton.setAttribute("aria-label", isLastPage ? "Start again" : "Next page");
    nextButton.title = isLastPage ? "Start again" : "Next page";
    pageCount.textContent = `${String(currentPage + 1).padStart(2, "0")} / ${String(storyPages.length).padStart(2, "0")}`;
    progressBar.setAttribute("aria-valuemax", String(storyPages.length));
    progressBar.setAttribute("aria-valuenow", String(currentPage + 1));
    progressFill.style.width = `${((currentPage + 1) / storyPages.length) * 100}%`;

    window.scrollTo({top:0,behavior:"smooth"});
}

function changePage(direction){
    if(currentPage === storyPages.length - 1 && direction > 0){
        showPage(0);
        return;
    }

    if(direction > 0 && storyPages[currentPage].classList.contains("choice-page")){
        return;
    }

    showPage(currentPage + direction);
}

function chooseOption(button){
    const reveal = document.getElementById(button.dataset.revealTarget);

    if(reveal){
        reveal.textContent = button.dataset.reveal;
        reveal.hidden = false;
        showPage(currentPage + 1);
    }
}

showPage(0);

/* ================= COUNTDOWN ================= */

const birthday = new Date("October 3, 2026 00:00:00").getTime();

function countdown(){

    const now = new Date().getTime();

    const distance = birthday - now;

    if(distance <= 0){

        document.querySelector(".countdown").innerHTML =
        "<div class='time' style='width:300px'><b>IT'S SHUU DAY ♡</b></div>";

        return;
    }

    const days =
    Math.floor(distance/(1000*60*60*24));

    const hours =
    Math.floor((distance%(1000*60*60*24))/(1000*60*60));

    const minutes =
    Math.floor((distance%(1000*60*60))/(1000*60));

    const seconds =
    Math.floor((distance%(1000*60))/1000);

    document.getElementById("days").innerText =
    String(days).padStart(2,"0");

    document.getElementById("hours").innerText =
    String(hours).padStart(2,"0");

    document.getElementById("minutes").innerText =
    String(minutes).padStart(2,"0");

    document.getElementById("seconds").innerText =
    String(seconds).padStart(2,"0");
}

countdown();

setInterval(countdown,1000);


/* ================= MUSIC ================= */

function playMusic(){

    const song = document.getElementById("song");

    if(song.paused){

        song.play();

        document.querySelector(".music").innerText =
        "♡ Pause our song";

    }else{

        song.pause();

        document.querySelector(".music").innerText =
        "♡ Play our song";

    }
}


/* ================= FLOATING HEARTS ================= */

setInterval(function(){

    const heart = document.createElement("div");

    heart.className="heart";

    heart.innerHTML=["♡","♥","✦"][Math.floor(Math.random()*3)];

    heart.style.left =
    Math.random()*100+"vw";

    heart.style.fontSize =
    (10+Math.random()*20)+"px";

    heart.style.animationDuration =
    (5+Math.random()*5)+"s";

    document.body.appendChild(heart);

    setTimeout(()=>{
        heart.remove();
    },10000);

},700);

</script>

</body>
</html>